# Firebase deploy cache — must NOT be tracked by git.
# If git reverts this file, Firebase CLI makes wrong delta-deploy decisions
# and can skip uploading changed files, causing stale CDN content.
.firebase/

# Firebase CLI logs — rewritten on every `emulators:start` and every deploy
firebase-debug.log*
firestore-debug.log*
database-debug.log*
ui-debug.log*

# Generated output (regenerated by scripts/compute-mf-scores.js)
# — except cc-history.json: the Coffee Can fetch cache is precious (first
#   backfill takes ~1h) and must persist across GitHub Actions runs
output/*
!output/cc-history.json

# Generated QA workbook (regenerated by scripts/generate-test-cases.js)
AishwaryaMasthu_TestCases.xlsx

# Standalone design/theme explorations — scratch work, never served by the app
# (firebase.json serves public/ only, so these were never deployed either)
mockups/

# Claude Code session-local files
.claude/settings.local.json
.claude/worktrees/

# Node
node_modules/
npm-debug.log*

# VS Code
.vscode/
